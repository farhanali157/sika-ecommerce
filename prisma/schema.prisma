generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

enum Role {
  CUSTOMER
  B2B
  ADMIN
  SUPER_ADMIN
}

enum ApplicationStatus {
  PENDING
  APPROVED
  REJECTED
  ACTION_REQUIRED
}

model B2BApplication {
  id                String            @id @default(cuid())
  userId            String            @unique
  companyName       String
  ntnNumber         String
  taxCertificateUrl String?
  businessProofUrl  String?
  status            ApplicationStatus @default(PENDING)
  notes             String?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum ProductStatus {
  IN_STOCK
  OUT_OF_STOCK
  DISCONTINUED
  BACKORDER
}

enum PaymentMethod {
  COD
  ONLINE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  name         String?
  companyName  String?
  ntnNumber    String?
  passwordHash String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt
  addresses    Address[]
  b2bApplication B2BApplication?
  orders       Order[]
  cart         Cart?     // <-- Back-relation to Cart
}

model Address {
  id         String   @id @default(cuid())
  userId     String
  street     String
  city       String
  province   String
  postalCode String
  country    String   @default("Pakistan")
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
}

model Category {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model ApplicationArea {
  id          String    @id @default(cuid())
  name        String    @unique
  slug        String    @unique
  description String?
  products    Product[]
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
}

model Product {
  id               String            @id @default(cuid())
  name             String
  slug             String            @unique
  sku              String            @unique
  description      String
  packSize         String
  images           String[]          @default([])
  tdsUrl           String?
  sdsUrl           String?
  categoryId       String
  category         Category          @relation(fields: [categoryId], references: [id])
  
  // NEW ADMIN FIELDS
  status           ProductStatus     @default(IN_STOCK)
  discountPercent  Float?            @default(0)
  isFeatured       Boolean           @default(false)
  isArchived       Boolean           @default(false)

  applicationAreas ApplicationArea[]
  tieredPrices     TieredPrice[]
  orderItems       OrderItem[]
  cartItems        CartItem[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@index([categoryId])
  @@index([isArchived, status])
  @@index([isFeatured])
}

model TieredPrice {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  minQty    Int
  price     Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([productId, minQty])
}

model Cart {
  id        String     @id @default(cuid())
  userId    String?    @unique
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  items     CartItem[]
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}

model CartItem {
  id        String   @id @default(cuid())
  cartId    String
  cart      Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  quantity  Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([cartId, productId])
}

enum OrderStatus {
  PENDING
  PROCESSING
  DISPATCHED
  DELIVERED
  CANCELLED
}

model Order {
  id              String      @id @default(cuid())
  userId          String?
  customerName    String
  customerEmail   String
  customerPhone   String
  shippingAddress String
  ntnNumber       String?
  notes           String?
  isDeleted   Boolean  @default(false)
  status          OrderStatus @default(PENDING)
  subtotal        Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee     Decimal     @default(0) @db.Decimal(10, 2)
  totalAmount     Decimal     @db.Decimal(12, 2)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  paymentMethod   PaymentMethod @default(COD)
  paymentStatus   PaymentStatus @default(PENDING)
  paymentTxnId    String?       // Transaction ID returned from payment gateway

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([status])
  @@index([isDeleted, createdAt])
  // Note: customerName/customerEmail/customerPhone are searched via `contains`
  // (ILIKE) in getAdminOrders. A standard B-tree index does not accelerate
  // ILIKE '%term%' lookups — if admin search becomes slow at scale, add a
  // trigram index instead, e.g.:
  //   CREATE EXTENSION IF NOT EXISTS pg_trgm;
  //   CREATE INDEX order_customer_search_trgm_idx ON "Order"
  //     USING GIN (("customerName" || ' ' || "customerEmail" || ' ' || "customerPhone") gin_trgm_ops);
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  productId String
  quantity  Int
  unitPrice Decimal  @db.Decimal(10, 2)
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([orderId])
  @@index([productId])
}

model StoreSetting {
  id                   String   @id @default(cuid())
  announcementMessages String   @default("[\"🎉 SIKA STOREWIDE SALE LIVE!\", \"🚚 FREE DELIVERY NATIONWIDE\", \"🏗️ PROFESSIONAL GRADE SOLUTIONS\"]")
  announcementBgColor  String   @default("#171717")
  announcementTextColor String  @default("#ffffff")
  isAnnouncementActive Boolean  @default(true)
  updatedAt            DateTime @updatedAt
}